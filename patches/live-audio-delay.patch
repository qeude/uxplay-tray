     parse_arguments (argc, argv);
 
+    /* UxPlay Tray patch: "delay <ms>" lines on stdin change the audio delay live (no restart, client stays connected). */
+    /* shortcut: unsynchronized 64-bit store, atomic in practice on x86-64/arm64; use std::atomic if upstreamed. */
+    std::thread([] {
+        std::string line;
+        float ms;
+        while (std::getline(std::cin, line)) {
+            if (sscanf(line.c_str(), "delay %f", &ms) == 1 && ms > -1000 && ms < 1000) {
+                audio_delay_alac = audio_delay_aac = (int64_t) (ms * 1000000);  /* nsecs */
+                printf("live audio delay: %.1f ms\n", ms);
+                fflush(stdout);
+            }
+        }
+    }).detach();
+
